# --- Tradier (market data, chains, AND options execution) ---
TRADIER_TOKEN=              # access token (sandbox: developer.tradier.com / live: dashboard.tradier.com API Access)
TRADIER_ACCOUNT_ID=         # your account number (e.g. VA######## sandbox, or brokerage acct #)
TRADIER_ENV=sandbox         # sandbox | live  (start with sandbox!)

# --- SEC EDGAR (free fundamentals; no login, just a contact UA) ---
EDGAR_USER_AGENT=SignalOS research your-email@example.com

# --- Optional alternative data providers ---
POLYGON_API_KEY=
DATABENTO_API_KEY=
ORATS_API_KEY=
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
