{
  "name": "cre-analyzer",
  "version": "1.0.0",
  "description": "Commercial Real Estate Lease vs. Buy analysis engine with mandatory property-tax normalization.",
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/index.js",
  "bin": {
    "cre-analyzer": "dist/cli/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/cli/index.js",
    "dev": "ts-node src/cli/index.ts",
    "analyze": "ts-node src/cli/index.ts analyze",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "decimal.js": "^10.4.3",
    "inquirer": "^8.2.6"
  },
  "devDependencies": {
    "@types/inquirer": "^8.2.10",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
